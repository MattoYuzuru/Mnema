{
  "schemaVersion": 1,
  "workflows": {
    ".github/workflows/dependency-review.yaml": {
      "jobs": {
        "dependency-review": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/deploy.yaml": {
      "jobs": {
        "assemble-vps-candidate": {
          "actions": "read",
          "contents": "read"
        },
        "backend-quality": {
          "contents": "read"
        },
        "build-and-push": {
          "attestations": "write",
          "contents": "read",
          "id-token": "write",
          "packages": "write"
        },
        "deploy-production": {
          "actions": "read",
          "attestations": "read",
          "contents": "read",
          "packages": "read"
        },
        "frontend-quality": {
          "contents": "read"
        },
        "post-deploy-smoke": {
          "contents": "read"
        },
        "release-scope": {
          "contents": "read",
          "deployments": "read"
        },
        "validate-main-ref": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/pull-request.yaml": {
      "jobs": {
        "backend-quality": {
          "contents": "read"
        },
        "frontend-quality": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/vps-deploy.yaml": {
      "jobs": {
        "operate-vps": {
          "contents": "read"
        }
      }
    }
  },
  "artifacts": [
    {
      "policyId": "pr-backend-jacoco",
      "workflow": ".github/workflows/pull-request.yaml",
      "job": "backend-quality",
      "name": "backend-jacoco-report",
      "paths": [
        "backend/build/reports/jacoco/jacocoRootReport/"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "internal-test-report",
      "source": "Gradle JaCoCo report generated by the backend quality gate"
    },
    {
      "policyId": "main-backend-jacoco",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "backend-quality",
      "name": "backend-jacoco-report",
      "paths": [
        "backend/build/reports/jacoco/jacocoRootReport/"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "internal-test-report",
      "source": "Gradle JaCoCo report generated by the backend quality gate"
    },
    {
      "policyId": "main-release-security",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "build-and-push",
      "name": "release-security-${{ matrix.name }}",
      "paths": [
        "${{ runner.temp }}/release-security/${{ matrix.name }}-*"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "security-evidence",
      "source": "Trivy, Syft and attestation verification output for the immutable image digest"
    },
    {
      "policyId": "main-release-image-digest",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "build-and-push",
      "name": "release-image-${{ matrix.name }}",
      "paths": [
        "${{ runner.temp }}/release-digests/${{ matrix.name }}.digest"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "release-identifier",
      "source": "Buildx immutable image digest output"
    },
    {
      "policyId": "main-vps-candidate",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "assemble-vps-candidate",
      "name": "vps-candidate",
      "paths": [
        "${{ runner.temp }}/vps-candidate.json",
        "${{ runner.temp }}/vps-security-evidence.json",
        "${{ runner.temp }}/vps-candidate.sha256"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "release-manifest",
      "source": "Five immutable VPS image identifiers and complete verified image security evidence; no secrets"
    }
  ]
}
