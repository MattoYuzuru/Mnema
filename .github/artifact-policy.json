{
  "schemaVersion": 1,
  "workflows": {
    ".github/workflows/database-recovery.yaml": {
      "jobs": {
        "database-recovery": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/dependency-review.yaml": {
      "jobs": {
        "dependency-review": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/deploy.yaml": {
      "jobs": {
        "backend-quality": {
          "contents": "read"
        },
        "build-and-push": {
          "attestations": "write",
          "contents": "read",
          "id-token": "write",
          "packages": "write"
        },
        "frontend-quality": {
          "contents": "read"
        },
        "render-release": {
          "actions": "read",
          "contents": "read"
        },
        "validate-main-ref": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/production-deploy.yaml": {
      "jobs": {
        "deploy-production": {
          "actions": "read",
          "contents": "read"
        },
        "preview-production": {
          "actions": "read",
          "contents": "read"
        },
        "validate-staging-deploy": {
          "actions": "read",
          "contents": "read"
        }
      }
    },
    ".github/workflows/pull-request.yaml": {
      "jobs": {
        "backend-quality": {
          "contents": "read"
        },
        "frontend-quality": {
          "contents": "read"
        }
      }
    },
    ".github/workflows/staging-deploy.yaml": {
      "jobs": {
        "deploy-staging": {
          "actions": "read",
          "contents": "read"
        },
        "validate-main-ci": {
          "actions": "read",
          "contents": "read"
        }
      }
    },
    ".github/workflows/staging-rollback-drill.yaml": {
      "jobs": {
        "rollback-drill": {
          "actions": "read",
          "contents": "read"
        }
      }
    }
  },
  "artifacts": [
    {
      "policyId": "pr-backend-jacoco",
      "workflow": ".github/workflows/pull-request.yaml",
      "job": "backend-quality",
      "name": "backend-jacoco-report",
      "paths": [
        "backend/build/reports/jacoco/jacocoRootReport/"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "internal-test-report",
      "source": "Gradle JaCoCo report generated by the backend quality gate"
    },
    {
      "policyId": "main-backend-jacoco",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "backend-quality",
      "name": "backend-jacoco-report",
      "paths": [
        "backend/build/reports/jacoco/jacocoRootReport/"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "internal-test-report",
      "source": "Gradle JaCoCo report generated by the backend quality gate"
    },
    {
      "policyId": "main-release-security",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "build-and-push",
      "name": "release-security-${{ matrix.name }}",
      "paths": [
        "${{ runner.temp }}/release-security/${{ matrix.name }}-*"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "security-evidence",
      "source": "Trivy, Syft and attestation verification output for the immutable image digest"
    },
    {
      "policyId": "main-release-image-digest",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "build-and-push",
      "name": "release-image-${{ matrix.name }}",
      "paths": [
        "${{ runner.temp }}/release-digests/${{ matrix.name }}.digest"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "release-identifier",
      "source": "Buildx immutable image digest output"
    },
    {
      "policyId": "main-production-release-manifest",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "render-release",
      "name": "production-release-manifest",
      "paths": [
        "${{ runner.temp }}/production-release.yaml",
        "${{ runner.temp }}/production-release.yaml.sha256",
        "${{ runner.temp }}/release-security-evidence.json",
        "${{ runner.temp }}/release-security-evidence.json.sha256"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "release-manifest",
      "source": "Immutable release renderer and aggregated image security evidence"
    },
    {
      "policyId": "main-staging-release-manifest",
      "workflow": ".github/workflows/deploy.yaml",
      "job": "render-release",
      "name": "staging-release-manifest",
      "paths": [
        "${{ runner.temp }}/staging-release.yaml",
        "${{ runner.temp }}/staging-release.yaml.sha256",
        "${{ runner.temp }}/release-security-evidence.json",
        "${{ runner.temp }}/release-security-evidence.json.sha256"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "release-manifest",
      "source": "Immutable staging release renderer and aggregated image security evidence"
    },
    {
      "policyId": "staging-release-record",
      "workflow": ".github/workflows/staging-deploy.yaml",
      "job": "deploy-staging",
      "name": "staging-release-record-${{ github.run_id }}",
      "paths": [
        "${{ env.RELEASE_RECORD }}"
      ],
      "retentionDays": 90,
      "ifNoFilesFound": "error",
      "classification": "release-state",
      "source": "release_state.py record after successful staging verification"
    },
    {
      "policyId": "staging-failure-diagnostics",
      "workflow": ".github/workflows/staging-deploy.yaml",
      "job": "deploy-staging",
      "name": "staging-release-diagnostics-${{ github.run_id }}",
      "paths": [
        "${{ env.DIAGNOSTICS_DIR }}",
        "${{ env.SMOKE_REPORT }}",
        "${{ env.ROLLBACK_SMOKE_REPORT }}",
        "${{ env.ROLLBACK_RECORD }}"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "sanitized-diagnostics",
      "source": "collect_diagnostics.py, release_smoke.py and release_state.py rollback output"
    },
    {
      "policyId": "production-release-preview",
      "workflow": ".github/workflows/production-deploy.yaml",
      "job": "preview-production",
      "name": "production-release-preview-${{ github.run_id }}-${{ github.run_attempt }}",
      "paths": [
        "${{ env.RELEASE_DIFF }}",
        "${{ env.RELEASE_PREVIEW_METADATA }}"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "sanitized-release-preview",
      "source": "capture-release-diff.sh with Kubernetes Secret values suppressed and bounded metadata"
    },
    {
      "policyId": "production-release-record",
      "workflow": ".github/workflows/production-deploy.yaml",
      "job": "deploy-production",
      "name": "production-release-record-${{ github.run_id }}",
      "paths": [
        "${{ env.RELEASE_RECORD }}"
      ],
      "retentionDays": 90,
      "ifNoFilesFound": "error",
      "classification": "release-state",
      "source": "release_state.py record after successful production verification"
    },
    {
      "policyId": "production-failure-diagnostics",
      "workflow": ".github/workflows/production-deploy.yaml",
      "job": "deploy-production",
      "name": "production-release-diagnostics-${{ github.run_id }}",
      "paths": [
        "${{ env.DIAGNOSTICS_DIR }}",
        "${{ env.SMOKE_REPORT }}",
        "${{ env.ROLLBACK_SMOKE_REPORT }}",
        "${{ env.ROLLBACK_RECORD }}"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "sanitized-diagnostics",
      "source": "collect_diagnostics.py, release_smoke.py and release_state.py rollback output"
    },
    {
      "policyId": "staging-rollback-drill",
      "workflow": ".github/workflows/staging-rollback-drill.yaml",
      "job": "rollback-drill",
      "name": "staging-rollback-drill-${{ github.run_id }}",
      "paths": [
        "${{ env.DIAGNOSTICS_DIR }}",
        "${{ env.BROKEN_MANIFEST }}",
        "${{ env.BROKEN_SMOKE_REPORT }}",
        "${{ env.ROLLBACK_RECORD }}",
        "${{ env.ROLLBACK_SMOKE_REPORT }}"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "warn",
      "classification": "sanitized-recovery-evidence",
      "source": "Bounded rollback drill manifest, redacted diagnostics, smoke reports and release record"
    },
    {
      "policyId": "database-restore-drill",
      "workflow": ".github/workflows/database-recovery.yaml",
      "job": "database-recovery",
      "name": "restore-drill-evidence-${{ github.run_id }}-${{ github.run_attempt }}",
      "paths": [
        "${{ env.EVIDENCE_DIR }}/restore-drill.json"
      ],
      "retentionDays": 30,
      "ifNoFilesFound": "error",
      "classification": "sanitized-recovery-evidence",
      "source": "backup/validate_report.py fixed-schema restore drill report"
    }
  ]
}
