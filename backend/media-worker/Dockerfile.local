# Local development only. See README.md before any external distribution.
ARG UBUNTU_BASE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
FROM ${UBUNTU_BASE}

# Ubuntu 24.04 arm64 archive does not expose the APT snapshot service. Pin the
# archive FFmpeg package and record the built image digest for local integration.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ffmpeg=7:6.1.1-3ubuntu5 python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mnema-media-worker
COPY mnema_media_worker ./mnema_media_worker
COPY tests ./tests
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/mnema-media-worker
USER 10001:10001
ENTRYPOINT ["python3", "-m", "mnema_media_worker"]
