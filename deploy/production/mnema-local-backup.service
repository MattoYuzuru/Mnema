[Unit]
Description=Mnema root-only local database backup (optional KMS-encrypted offsite copy)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mnema-local-backup backup
User=root
UMask=0077
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
