{
  "contract": "deck-hub-v1",
  "description": "Shared frontend/backend fixtures for the Deck hub (#285): insights, the exerciseCount sort/include on the item list, the exemplar command and bulk deletion. Shapes follow the Deck and Item contracts (private/no-store, decimal-string versions, quoted ETags, RFC 9457 problems). Illustrative cursors are opaque; clients never parse them. `invariants` are executable: the contract fixture test checks them against the examples.",
  "constants": {
    "exemplarLimit": 10,
    "bulkDeleteChunkSize": 100,
    "bulkDeleteMaxSelection": 500,
    "listPageDefault": 20,
    "listPageMax": 100,
    "dueDays": 7,
    "defaultTimezone": "Europe/Moscow",
    "mechanics": [
      "SELF_CHECK",
      "FREE_RESPONSE",
      "CLOZE",
      "CHOICE",
      "MATCH",
      "ORDER",
      "CATEGORIZE"
    ],
    "states": [
      "NOT_STARTED",
      "LEARNING",
      "DUE",
      "ON_TRACK"
    ]
  },
  "invariants": [
    "insights.response.coverage.total = withExercises + withoutExercises = sum(states)",
    "sum(exercisesByMechanic) = sum of every material's exerciseCount (enabled current exercises)",
    "dueByDay has exactly 7 entries: consecutive local dates, entry 0 is today and includes everything already due",
    "sum(dueByDay.materials) <= coverage.total",
    "items.sortedPage: exerciseCount ascending, ties by ordinal ascending, no repeats across pages",
    "bulkDelete results: requested = deleted + length(notDeleted); status COMPLETED iff notDeleted is empty; PARTIAL implies 0 < deleted",
    "exemplar.acknowledgement.exemplarCount <= constants.exemplarLimit"
  ],
