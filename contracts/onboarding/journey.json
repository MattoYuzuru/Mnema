  "transitions": {
    "note": "from-state → to-state per action; a pair that is absent is 409 ONBOARDING_TRANSITION. stepKey: required | optional | forbidden. branch is accepted only where listed",
    "START": {
      "from": {
        "OFFERED": "IN_PROGRESS"
      },
      "stepKey": "required",
      "branch": "forbidden"
    },
    "STEP": {
      "from": {
        "IN_PROGRESS": "IN_PROGRESS"
      },
      "stepKey": "required",
      "branch": "optional"
    },
    "PAUSE": {
      "from": {
        "IN_PROGRESS": "PAUSED"
      },
      "stepKey": "optional",
      "branch": "forbidden"
    },
    "RESUME": {
      "from": {
        "PAUSED": "IN_PROGRESS"
      },
      "stepKey": "optional",
      "branch": "optional"
    },
    "SKIP": {
      "from": {
        "OFFERED": "SKIPPED"
      },
      "stepKey": "forbidden",
      "branch": "forbidden",
      "sets": [
        "finishedAt"
      ]
    },
    "COMPLETE": {
      "from": {
        "IN_PROGRESS": "COMPLETED",
        "PAUSED": "COMPLETED"
      },
      "stepKey": "forbidden",
      "branch": "forbidden",
      "sets": [
        "finishedAt"
      ]
    },
    "UNDO_FINISH": {
      "from": {
        "SKIPPED": "OFFERED",
        "COMPLETED": "PAUSED"
      },
      "stepKey": "forbidden",
      "branch": "forbidden",
      "clears": [
        "finishedAt"
      ]
    },
    "REPLAY": {
      "from": {
        "NOT_OFFERED": "IN_PROGRESS",
        "OFFERED": "IN_PROGRESS",
        "PAUSED": "IN_PROGRESS",
        "SKIPPED": "IN_PROGRESS",
        "COMPLETED": "IN_PROGRESS"
      },
      "stepKey": "required",
      "branch": "forbidden",
      "sets": [
        "replayCount + 1",
        "tourVersion = current"
      ],
      "clears": [
        "branch",
        "finishedAt"
      ],
      "note": "from NOT_OFFERED the row is created outside the cohort (eligible=false, replayCount 1)"
    }
  },
