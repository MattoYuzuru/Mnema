{
  "contract": "generation-v1",
  "description": "Progress events of a session: an append-only log read by adaptive polling. Authority: docs/architecture/ai-generation-platform.md section 5. No token streaming, EventSource or WebSocket in v1; if a streaming endpoint is added later (p50 time to first block above 5 s), the event contract does not change.",
  "request": {
    "method": "GET",
    "path": "/api/decks/{deckId}/generation-sessions/{sessionId}/events",
    "query": {
      "after": "decimal cursor, default 0",
      "limit": "1..100, default 100"
    }
  },
  "envelope": {
    "fields": {
      "events": "Events with eventId > after, ascending, at most limit.",
      "cursor": "Decimal string: eventId of the last returned event, or the request's after when events is empty. The client sends it as the next after.",
      "session": "{state, rowVersion}: the session now, independent of the events returned, so a poll can stop on a terminal state.",
      "activeSteps": "Steps currently READY, RUNNING or WAITING_EXTERNAL: {stepId, artifactId|null, kind, state, startedAt|null}. Drives 'writing' indicators; empty when nothing is active."
    },
    "example": {
      "events": [
        {
          "eventId": "101",
          "type": "ARTIFACT_STATE",
          "sessionId": "5e550000-0000-4000-8000-000000000001",
          "artifactId": "a7a70000-0000-4000-8000-000000000001",
          "occurredAt": "2026-10-02T09:00:41Z",
          "payload": {
            "state": "PROPOSED",
            "artifactVersion": "4",
            "currentRevisionId": "4e700000-0000-4000-8000-000000000001",
            "errorCode": null,
            "repinStatus": null
          }
        },
        {
          "eventId": "102",
          "type": "BLOCKS_APPENDED",
          "sessionId": "5e550000-0000-4000-8000-000000000001",
          "artifactId": "a7a70000-0000-4000-8000-000000000002",
          "occurredAt": "2026-10-02T09:00:42Z",
          "payload": {
            "generation": 1,
            "startIndex": 2,
            "blocks": [
              {
                "id": "00000000-0000-4000-8000-000000000014",
                "type": "paragraph",
                "version": 1,
                "attrs": {},
                "content": [
                  {
                    "id": "00000000-0000-4000-8000-000000000015",
                    "type": "text",
                    "version": 1,
                    "attrs": {
                      "text": "Index Scan читает только нужные страницы.",
                      "marks": []
                    },
                    "content": []
                  }
                ]
              }
            ]
          }
        },
        {
          "eventId": "103",
          "type": "MEDIA_SLOT_STATE",
          "sessionId": "5e550000-0000-4000-8000-000000000001",
          "artifactId": "a7a70000-0000-4000-8000-000000000001",
          "occurredAt": "2026-10-02T09:00:43Z",
          "payload": {
            "slotKey": "a1",
            "kind": "AUDIO",
            "state": "READY",
            "assetId": "00000000-0000-4000-a000-000000000001",
            "errorCode": null
          }
        },
        {
          "eventId": "104",
          "type": "USAGE_UPDATED",
          "sessionId": "5e550000-0000-4000-8000-000000000001",
          "artifactId": null,
          "occurredAt": "2026-10-02T09:00:44Z",
          "payload": {
            "reservedCredits": 21,
            "spentCredits": 11,
            "balanceRemainingCredits": 297
          }
        },
        {
          "eventId": "105",
          "type": "SESSION_STATE",
          "sessionId": "5e550000-0000-4000-8000-000000000001",
          "artifactId": null,
          "occurredAt": "2026-10-02T09:00:45Z",
          "payload": {
            "state": "RUNNING",
            "rowVersion": "12",
            "artifactCounts": {
              "QUEUED": 1,
              "GENERATING": 1,
              "PROPOSED": 7,
              "REVISING": 0,
              "FAILED": 1,
              "REJECTED": 0,
              "STALE": 0,
              "PUBLISHED": 0,
              "HANDED_OFF": 0
            }
          }
        }
      ],
      "cursor": "105",
      "session": {
        "state": "RUNNING",
        "rowVersion": "12"
      },
      "activeSteps": [
        {
          "stepId": "57e70000-0000-4000-8000-000000000001",
          "artifactId": "a7a70000-0000-4000-8000-000000000002",
          "kind": "TEXT_DRAFT",
          "state": "RUNNING",
          "startedAt": "2026-10-02T09:00:42Z"
        }
      ]
    },
    "emptyExample": {
      "events": [],
      "cursor": "105",
      "session": {
        "state": "REVIEW",
        "rowVersion": "13"
      },
      "activeSteps": []
    }
  },
  "eventFields": {
    "eventId": "Decimal string from a bigserial; strictly increasing, not dense (other sessions share the sequence). Never reused.",
    "type": "ARTIFACT_STATE | BLOCKS_APPENDED | MEDIA_SLOT_STATE | USAGE_UPDATED | SESSION_STATE. A client ignores unknown types.",
    "sessionId": "Always the requested session.",
    "artifactId": "null for session-level events.",
    "occurredAt": "UTC RFC 3339.",
    "payload": "Small (the log row is bounded; BLOCKS_APPENDED at most 32 KiB). Large content is read with getArtifact."
  },
  "types": {
    "ARTIFACT_STATE": {
      "emittedBy": "every artifact transition in states.json",
      "payload": {
        "state": "artifact state",
        "artifactVersion": "new rowVersion",
        "currentRevisionId": "uuid|null",
        "errorCode": "null or artifact error code",
        "repinStatus": "null | AUTO_REPINNED | NEEDS_USER_DECISION"
      },
      "clientRule": "On PROPOSED (and on any change of currentRevisionId) re-read the artifact with getArtifact.",
      "example": {
        "eventId": "101",
        "type": "ARTIFACT_STATE",
        "sessionId": "5e550000-0000-4000-8000-000000000001",
        "artifactId": "a7a70000-0000-4000-8000-000000000001",
        "occurredAt": "2026-10-02T09:00:41Z",
        "payload": {
          "state": "PROPOSED",
          "artifactVersion": "4",
          "currentRevisionId": "4e700000-0000-4000-8000-000000000001",
          "errorCode": null,
          "repinStatus": null
        }
      }
    },
    "BLOCKS_APPENDED": {
      "emittedBy": "TEXT_DRAFT checkpoints, at most every 750 ms or at a block boundary",
      "payload": {
        "generation": "Integer attempt number of the drafting step. A higher generation than the one the client holds means the draft restarted (retry or repair): discard earlier blocks.",
        "startIndex": "0-based index of blocks[0] among the draft's top-level blocks.",
        "blocks": "Already compiled native-v1 top-level block nodes, at most 32 KiB."
      },
      "clientRule": "Draft blocks are a preview: their node IDs are provisional and can differ from the stored revision. The truth is getArtifact after ARTIFACT_STATE=PROPOSED. Reveal blocks with an ink animation of at most 600 ms; no event is a live region.",
      "example": {
        "eventId": "102",
        "type": "BLOCKS_APPENDED",
        "sessionId": "5e550000-0000-4000-8000-000000000001",
        "artifactId": "a7a70000-0000-4000-8000-000000000002",
        "occurredAt": "2026-10-02T09:00:42Z",
        "payload": {
          "generation": 1,
          "startIndex": 2,
          "blocks": [
            {
              "id": "00000000-0000-4000-8000-000000000014",
              "type": "paragraph",
              "version": 1,
              "attrs": {},
              "content": [
                {
                  "id": "00000000-0000-4000-8000-000000000015",
                  "type": "text",
                  "version": 1,
                  "attrs": {
                    "text": "Index Scan читает только нужные страницы.",
                    "marks": []
                  },
                  "content": []
                }
              ]
            }
          ]
        }
      }
    },
    "MEDIA_SLOT_STATE": {
      "emittedBy": "every media slot transition in states.json",
      "payload": {
        "slotKey": "stable key of the slot",
        "kind": "AUDIO | IMAGE | VIDEO",
        "state": "slot state",
        "assetId": "uuid pre-allocated by the compiler",
        "errorCode": "null or error code"
      },
      "clientRule": "READY: the renderer resolves the asset through the media APIs; until then it shows the paper placeholder frame.",
      "example": {
        "eventId": "103",
        "type": "MEDIA_SLOT_STATE",
        "sessionId": "5e550000-0000-4000-8000-000000000001",
        "artifactId": "a7a70000-0000-4000-8000-000000000001",
        "occurredAt": "2026-10-02T09:00:43Z",
        "payload": {
          "slotKey": "a1",
          "kind": "AUDIO",
          "state": "READY",
          "assetId": "00000000-0000-4000-a000-000000000001",
          "errorCode": null
        }
      }
    },
    "USAGE_UPDATED": {
      "emittedBy": "every committed DEBIT or RELEASE of the session's reservation",
      "payload": {
        "reservedCredits": "hold of the session",
        "spentCredits": "debited so far",
        "balanceRemainingCredits": "account credits.remaining now"
      },
      "example": {
        "eventId": "104",
        "type": "USAGE_UPDATED",
        "sessionId": "5e550000-0000-4000-8000-000000000001",
        "artifactId": null,
        "occurredAt": "2026-10-02T09:00:44Z",
        "payload": {
          "reservedCredits": 21,
          "spentCredits": 11,
          "balanceRemainingCredits": 297
        }
      }
    },
    "SESSION_STATE": {
      "emittedBy": "every session transition in states.json",
      "payload": {
        "state": "session state",
        "rowVersion": "new rowVersion",
        "artifactCounts": "one integer per artifact state"
      },
      "example": {
        "eventId": "105",
        "type": "SESSION_STATE",
        "sessionId": "5e550000-0000-4000-8000-000000000001",
        "artifactId": null,
        "occurredAt": "2026-10-02T09:00:45Z",
        "payload": {
          "state": "RUNNING",
          "rowVersion": "12",
          "artifactCounts": {
            "QUEUED": 1,
            "GENERATING": 1,
            "PROPOSED": 7,
            "REVISING": 0,
            "FAILED": 1,
            "REJECTED": 0,
            "STALE": 0,
            "PUBLISHED": 0,
            "HANDED_OFF": 0
          }
        }
      }
    }
  },
  "polling": {
    "clientCadence": "One loop per open session: 1 s while the tab is visible and a step is active; 5-15 s in the background; immediately on visibilitychange; stop when session.state is CLOSED, CANCELLED or EXPIRED.",
    "retention": "Events are kept until the session is closed plus one day. A request after that, or for a deleted session, is answered like any absent resource (404) and the client reconciles with getSession/listSessions.",
    "ordering": "Per session, eventId order is commit order; two events of one transaction share a transaction but have distinct IDs.",
    "idempotentReads": "Reading the same cursor twice returns the same events (no consumer state on the server)."
  }
}
