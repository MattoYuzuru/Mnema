{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnema.app/contracts/generation/exercises/output.schema.json",
  "title": "Model output of exercise generation (generation-v1)",
  "description": "Strict JSON a model writes for EXERCISES sessions. The root is an object because JSON-object response modes require one. Local IDs (o1, l1, r1, bl1, i1, c1) and handles (m1, m1:b3, t1) are the only identifiers the model ever sees or writes; the server allocates real UUIDs and compiles the ExerciseCommand. The schema is a hint for the provider; the source of truth is the server validation described in README.md. Keywords are limited to the subset the repository's fixture validator supports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exercises"
  ],
  "properties": {
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/exercise"
      }
    }
  },
  "$defs": {
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "TEXT"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "materialBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "const": "MATERIAL"
        },
        "ref": {
          "type": "string",
          "pattern": "^m[0-9]+:b[0-9]+$"
        }
      }
    },
    "objective": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^t[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      ]
    },
    "exercise": {
      "anyOf": [
        {
          "$ref": "#/$defs/selfCheck"
        },
        {
          "$ref": "#/$defs/freeResponse"
        },
        {
          "$ref": "#/$defs/cloze"
        },
        {
          "$ref": "#/$defs/choice"
        },
        {
          "$ref": "#/$defs/match"
        },
        {
          "$ref": "#/$defs/order"
        },
        {
          "$ref": "#/$defs/categorize"
        }
      ]
    },
    "selfCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "reference"
      ],
      "properties": {
        "mechanic": {
          "const": "SELF_CHECK"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "reference": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        }
      }
    },
    "freeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "accepted",
        "matchingMode"
      ],
      "properties": {
        "mechanic": {
          "const": "FREE_RESPONSE"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "reference": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "accepted": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "matchingMode": {
          "enum": [
            "STRICT",
            "SOFT"
          ]
        },
        "normalization": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "UNICODE_NFC",
              "TRIM",
              "CASE_FOLD"
            ]
          }
        }
      }
    },
    "cloze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "passage",
        "blanks"
      ],
      "properties": {
        "mechanic": {
          "const": "CLOZE"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "passage": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text"
                ],
                "properties": {
                  "kind": {
                    "const": "TEXT"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "blank",
                  "size",
                  "firstLetterHint"
                ],
                "properties": {
                  "kind": {
                    "const": "BLANK"
                  },
                  "blank": {
                    "type": "string",
                    "pattern": "^bl[0-9]+$"
                  },
                  "firstLetterHint": {
                    "type": "boolean"
                  },
                  "size": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "mode"
                        ],
                        "properties": {
                          "mode": {
                            "const": "ANSWER_LENGTH"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "mode",
                          "length"
                        ],
                        "properties": {
                          "mode": {
                            "const": "FIXED"
                          },
                          "length": {
                            "type": "integer",
                            "minimum": 5,
                            "maximum": 20
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "blanks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "blank",
              "accepted",
              "matchingMode"
            ],
            "properties": {
              "blank": {
                "type": "string",
                "pattern": "^bl[0-9]+$"
              },
              "accepted": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "matchingMode": {
                "enum": [
                  "STRICT",
                  "SOFT"
                ]
              },
              "normalization": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "UNICODE_NFC",
                    "TRIM",
                    "CASE_FOLD"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "selectionMode",
        "options"
      ],
      "properties": {
        "mechanic": {
          "const": "CHOICE"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "selectionMode": {
          "enum": [
            "SINGLE",
            "MULTIPLE"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text",
                  "correct"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^o[0-9]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "correct": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text",
                  "correct",
                  "whyWrong"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^o[0-9]+$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "correct": {
                    "const": false
                  },
                  "whyWrong": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            ]
          }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "left",
        "right",
        "pairs"
      ],
      "properties": {
        "mechanic": {
          "const": "MATCH"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "left": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^l[0-9]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "right": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^r[0-9]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "type": "string",
                "pattern": "^l[0-9]+$"
              },
              "right": {
                "type": "string",
                "pattern": "^r[0-9]+$"
              }
            }
          }
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "items"
      ],
      "properties": {
        "mechanic": {
          "const": "ORDER"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^i[0-9]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "categorize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanic",
        "subject",
        "objective",
        "prompt",
        "categories",
        "items"
      ],
      "properties": {
        "mechanic": {
          "const": "CATEGORIZE"
        },
        "subject": {
          "type": "string",
          "pattern": "^m[0-9]+$"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "prompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textBlock"
              },
              {
                "$ref": "#/$defs/materialBlock"
              }
            ]
          }
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^c[0-9]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "category"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^i[0-9]+$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "category": {
                "type": "string",
                "pattern": "^c[0-9]+$"
              }
            }
          }
        }
      }
    }
  }
}
